{
  "path": "npm-shrinkwrap.json",
  "type": "npm",
  "validate-https": true,
  "validate-package-names": true,
  "validate-integrity": true,
  "allowed-hosts": ["npm"],
  "allowed-package-name-aliases": [
    "string-width-cjs:string-width",
    "strip-ansi-cjs:strip-ansi",
    "wrap-ansi-cjs:wrap-ansi"
  ],
  "integrity-exclude": [
    "atob-lite",
    "btoa-lite",
    "clone",
    "clone-response",
    "decompress-response",
    "defaults",
    "duplexer3",
    "escape-string-regexp",
    "import-lazy",
    "imurmurhash",
    "is-stream",
    "is-typedarray",
    "isexe",
    "json-buffer",
    "npm-run-path",
    "once",
    "os-tmpdir",
    "p-finally",
    "path-key",
    "prepend-http",
    "responselike",
    "shebang-command",
    "shebang-regex",
    "stack-chain",
    "strip-json-comments",
    "through",
    "url-parse-lax",
    "util-deprecate",
    "wcwidth",
    "wrappy"
  ]
}
